{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "attention v1",
  "description": "앱이 관제소로 내보내는 확인할 일 스냅샷. 계약 원본이며 Flask 검증기(app_attention_validation.py)와 같은 판정을 내려야 한다. 스키마로 표현할 수 없는 규칙: items 안 key 중복(뒤의 것 버림), admin_url이 http 또는 형식 불량이면 그 URL만 버림(항목은 유지), 모르는 필드 무시.",
  "type": "object",
  "required": ["schema", "version", "source", "generated_at", "items"],
  "properties": {
    "schema": { "const": "attention" },
    "version": {
      "description": "주.부. 주 버전 1만 받고 부 버전은 무시",
      "type": "string",
      "pattern": "^1\\.(0|[1-9][0-9]*)$"
    },
    "source": {
      "type": "object",
      "required": ["app"],
      "properties": {
        "app": { "type": "string", "minLength": 1 },
        "app_version": { "type": "string" },
        "environment": { "enum": ["production", "staging", "development"] },
        "admin_base_url": { "type": "string", "pattern": "^https://[^\\s]+$", "maxLength": 2048 }
      }
    },
    "generated_at": { "$ref": "#/$defs/timestamp" },
    "poll_after_seconds": { "type": "integer", "minimum": 0 },
    "items": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "#/$defs/item" }
    }
  },
  "$defs": {
    "timestamp": {
      "description": "UTC ISO 8601 (Z 또는 오프셋)",
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,9})?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$"
    },
    "item": {
      "type": "object",
      "required": ["key", "label", "kind", "level"],
      "properties": {
        "key": {
          "description": "한 번 정하면 바꾸지 않는다 (이력, 덮어쓰기, 알림 상태가 묶임)",
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+){1,3}$"
        },
        "label": { "type": "string", "minLength": 1, "maxLength": 40, "pattern": "\\S" },
        "kind": {
          "description": "count / gauge / state. 모르는 kind도 유효 (label, detail, level만 표시)",
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "level": { "enum": ["ok", "info", "warning", "critical"] },
        "group": { "type": "string", "maxLength": 20 },
        "description": { "type": "string", "maxLength": 200 },
        "admin_url": {
          "description": "절대 https URL 또는 /로 시작하는 상대 경로(admin_base_url 기준). 그 외는 URL만 버림",
          "type": "string",
          "maxLength": 2048
        },
        "latest_at": { "$ref": "#/$defs/timestamp" },
        "detail": { "type": "string", "maxLength": 80 }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "count" } }, "required": ["kind"] },
          "then": {
            "required": ["count"],
            "properties": {
              "count": { "type": "integer", "minimum": 0 },
              "total": { "type": "integer", "minimum": 0 }
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "gauge" } }, "required": ["kind"] },
          "then": {
            "required": ["value"],
            "properties": {
              "value": { "type": "number" },
              "limit": { "type": "number" },
              "unit": { "type": "string", "maxLength": 12 }
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "state" } }, "required": ["kind"] },
          "then": {
            "required": ["state"],
            "properties": {
              "state": { "enum": ["ok", "degraded", "down", "unknown"] }
            }
          }
        }
      ]
    }
  }
}
